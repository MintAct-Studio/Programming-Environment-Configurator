  {
    "id": "vscode",
    "name": "VS Code",
    "category": "编辑器",
    "version": "最新稳定版",
    "channel": "manual",
    "defaultSubdir": "vscode",
    "locationPolicy": "flexible",
    "sizeMB": 110,
    "requiresAdmin": false,
    "manualInstall": true,
    "manual": {
      "downloadPage": "https://code.visualstudio.com/download",
      "directUrl": "https://update.code.visualstudio.com/latest/win32-x64-archive/stable",
      "why": "AutoED 不代下 VS Code：微软只提供单一 CDN（vscode.download.prss.microsoft.com），实测 0.3 MB/s，110 MB 需约 14 分钟；曾经可用的国内镜像 vscode.cdn.azure.cn 已失效。这个速度放在自动安装流程里，用户看到的是一条近乎不动的进度条，会误以为程序卡死或网络断了。宁可给出明确的下载方式，让你用浏览器（自带断点与多线程）下载，几秒钟就能开始。",
      "steps": [
        "点「打开下载页」，在浏览器里选择 Windows x64 的 zip 版（不要选安装器版）",
        "下载完成后解压到任意目录，例如 D:\\AutoED-env\\vscode",
        "回到 AutoED，点「导入已下载的目录」，选中刚才解压的文件夹",
        "AutoED 会校验 Code.exe、建立便携模式数据目录 data，并把 code 命令加入 PATH"
      ],
      "verifyFile": "Code.exe"
    },
    "why": "通用编辑器，Python / Node / C++ 三套插件生态都最全；以便携模式运行，数据留在安装目录，不占 C 盘",
    "requires": { "minFreeDiskGB": 1 }
  },
